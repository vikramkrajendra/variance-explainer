run = "pip install -q -r requirements.txt && python main.py"
modules = ["python-3.11"]
entrypoint = "main.py"

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 8080
externalPort = 80

[deployment]
run = ["sh", "-c", "pip install -r requirements.txt && gunicorn --bind 0.0.0.0:8080 --timeout 120 main:app"]
deploymentTarget = "cloudrun"
